#!/usr/bin/env bash
# 커밋되는 게시글(content/**/index.md)의 frontmatter `update:`를 오늘 날짜로 갱신한다.
# 활성화(PC마다 1회): git config core.hooksPath .githooks
set -euo pipefail

today=$(date +%Y-%m-%d)

git diff --cached --name-only --diff-filter=AM -- 'content/**/index.md' | while IFS= read -r file; do
  [ -f "$file" ] || continue
  grep -q '^update:' "$file" || continue
  # ponytail: 워크트리 파일을 수정 후 전체를 다시 스테이징한다. 부분 스테이징(git add -p)한 글은 나머지 변경도 함께 커밋된다.
  perl -pi -e "s/^update:.*/update: \"$today\"/" "$file"
  git add -- "$file"
done
